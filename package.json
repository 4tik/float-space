{
  "name": "float-space",
  "productName": "Float-Space",
  "version": "1.0.0",
  "description": "Cross-Platform Native Desktop Floating Workspace & Application Manager",
  "author": "Float-Space Team",
  "main": "dist/electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:electron && npm run build:renderer",
    "start": "electron dist/electron/main/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "premake:win": "powershell -Command \"Stop-Process -Name 'Float-Space' -Force -ErrorAction SilentlyContinue; exit 0\"",
    "make": "npm run build && electron-builder",
    "make:win": "npm run build && electron-builder --win",
    "make:mac": "npm run build && electron-builder --mac",
    "make:linux": "npm run build && electron-builder --linux",
    "predist:win": "powershell -Command \"Stop-Process -Name 'Float-Space' -Force -ErrorAction SilentlyContinue; exit 0\"",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "zustand": "^5.0.2"
  }
}
