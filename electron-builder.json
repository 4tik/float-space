{
  "appId": "com.floatspace.desktop",
  "productName": "Float-Space",
  "copyright": "Copyright © 2026 Float-Space Team",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Float-Space",
    "uninstallDisplayName": "Float-Space",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "artifactName": "Float-Space-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "Float-Space-Portable-${version}.${ext}"
  },
  "mac": {
    "category": "public.app-category.productivity",
    "target": ["dmg", "zip"],
    "artifactName": "Float-Space-${version}.${ext}",
    "hardenedRuntime": true,
    "gatekeeperAssess": false
  },
  "dmg": {
    "title": "Float-Space ${version}",
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "artifactName": "Float-Space-${version}.${ext}",
    "category": "Utility"
  }
}
